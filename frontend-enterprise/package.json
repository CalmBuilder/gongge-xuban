{
  "name": "gongge-xuban-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5137 --strictPort",
    "i18n:check": "node scripts/check-i18n.cjs",
    "brand:check": "node scripts/check-brand.cjs",
    "brand:check:test": "node --test scripts/check-brand.test.cjs",
    "config:check": "node scripts/check-vite-env.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "npm run build && playwright test --config playwright.fullstack.config.ts",
    "test:e2e:install": "playwright install chromium",
    "e2e:serve": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "pinyin-pro": "^3.28.1",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.12.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
