APP_ENV="production"
SINGLE_PORT="true"
APP_HOST="0.0.0.0"
APP_PORT="5137"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
ENTERPRISE_HOST="0.0.0.0"
ENTERPRISE_PORT="5137"
AUTO_RESTART="true"
DEV_STARTUP_TIMEOUT="180"
APP_NAME="共格·序伴"
DATABASE_URL="sqlite:///./gongge_xuban.db"
# MySQL 8.4 (optional; URL-encode special characters in the password):
# DATABASE_URL="mysql+pymysql://gongge_xuban:URL_ENCODED_PASSWORD@127.0.0.1:3306/gongge_xuban?charset=utf8mb4"
DATABASE_POOL_SIZE="10"
DATABASE_MAX_OVERFLOW="20"
DATABASE_POOL_TIMEOUT_SECONDS="30"
DATABASE_POOL_RECYCLE_SECONDS="1800"
APP_SECRET="replace-with-at-least-32-random-characters"
DEMO_MODEL_BASE_URL="http://127.0.0.1:52010/v1"
DEMO_MODEL_NAME="qwen3.6-27b"
DEMO_MODEL_API_KEY=""
MODEL_THINKING_MODE=""
MODEL_THINKING_MODELS=""
DYNAMIC_TASK_ROUTER_SHADOW_ENABLED="false"
DYNAMIC_TASK_ROUTER_SHADOW_TIMEOUT_SECONDS="2"
DYNAMIC_TASK_ROUTER_SHADOW_MIN_CONFIDENCE="0.7"
DYNAMIC_TASK_EXECUTION_ENABLED="false"
DYNAMIC_TASK_STEERING_ENABLED="false"
# 允许用户或 Agent 在活动动态任务的安全边界加载固定 Skill 修订并重规划。
DYNAMIC_TASK_SKILL_LOADING_ENABLED="false"
# 1 保持旧串行语义；能力契约显式 parallel_safe 后才可逐步提高，硬上限 8。
DYNAMIC_TASK_MAX_PARALLEL_READS="1"
DYNAMIC_TASK_EXTERNAL_WRITE_ENABLED="false"
DYNAMIC_TASK_STANDING_APPROVAL_ENABLED="false"
DYNAMIC_TASK_EXPLORE_ENABLED="false"
DYNAMIC_TASK_MANAGED_WORKSPACE_ENABLED="false"
# 只允许部署方预先放入的 tenant/workspace Git 仓库；不要指向项目根目录或用户主目录。
DYNAMIC_TASK_MANAGED_WORKSPACE_ROOT="./data/managed-code-workspaces"
GENERAL_SKILL_AGENT_PROPOSAL_ENABLED="false"
GENERAL_SKILL_AGENT_PROPOSAL_APPROVAL_TTL_SECONDS="900"
# 动态执行总开关打开后仍须同时命中 tenant/Agent 灰度列表；空值默认拒绝，* 表示显式全量。
DYNAMIC_TASK_TENANT_ALLOWLIST=""
DYNAMIC_TASK_AGENT_ALLOWLIST=""
DYNAMIC_TASK_SIGNAL_DISPATCH_WORKERS="4"
DYNAMIC_TASK_SIGNAL_DISPATCH_CAPACITY="16"
# 生产告警阈值必须按部署规模显式填写；0 表示未配置，运维快照会报告 not ready。
DYNAMIC_TASK_ALERT_SIGNAL_BACKLOG_THRESHOLD="0"
DYNAMIC_TASK_ALERT_DEAD_LETTER_THRESHOLD="0"
DYNAMIC_TASK_ALERT_UNKNOWN_OPERATION_THRESHOLD="0"
DYNAMIC_TASK_ALERT_PUBLICATION_BACKLOG_THRESHOLD="0"
DYNAMIC_TASK_ALERT_WAITING_AGE_SECONDS="0"
# 四级并发上限同样必须依据容量测试填写；0 会保持动态执行默认拒绝。
DYNAMIC_TASK_MAX_ACTIVE_PER_TENANT="0"
DYNAMIC_TASK_MAX_ACTIVE_PER_AGENT="0"
DYNAMIC_TASK_MAX_ACTIVE_PER_USER="0"
DYNAMIC_TASK_MAX_ACTIVE_PER_TOOL="0"
# Web 附件分析与上传配额；并发槽、TTL 和日字节用量均以数据库为权威。
ATTACHMENT_ANALYSIS_ENABLED="false"
ATTACHMENT_PARSER_WORKER_ENABLED="false"
ATTACHMENT_UPLOAD_CHUNK_BYTES="262144"
ATTACHMENT_MAX_FILE_BYTES="12582912"
ATTACHMENT_MAX_REQUEST_BYTES="50331648"
ATTACHMENT_MULTIPART_OVERHEAD_BYTES="1048576"
ATTACHMENT_UPLOAD_USER_CONCURRENCY="2"
ATTACHMENT_UPLOAD_TENANT_CONCURRENCY="20"
ATTACHMENT_UPLOAD_RESERVATION_TTL_SECONDS="180"
ATTACHMENT_UPLOAD_USER_DAILY_BYTES="1073741824"
ATTACHMENT_UPLOAD_TENANT_DAILY_BYTES="21474836480"
ATTACHMENT_PARSER_TIMEOUT_SECONDS="60"
ATTACHMENT_PARSER_MEMORY_MB="512"
ATTACHMENT_SCAN_ASSURANCE="format_verified"
# Slack OAuth v2（可选；redirect URI 必须与 Slack App 配置一致并使用 HTTPS）
SLACK_OAUTH_CLIENT_ID=""
SLACK_OAUTH_CLIENT_SECRET=""
SLACK_OAUTH_REDIRECT_URI=""
# 企业微信三元凭据只用于一次性本地导入；建档成功后应从 .env 删除，运行时读取加密档案。
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_CORP_SECRET=""
TOOL_TIMEOUT_SECONDS="8"
TOOL_BASE_URL="http://localhost:5137"
# 允许临时工具/MCP 探测访问的内网主机，逗号分隔；公网地址无需加入。
TOOL_OUTBOUND_ALLOWED_HOSTS=""
PUBLIC_MOCK_API_KEY="replace-with-a-random-secret"
PUBLIC_MOCK_LLM_ENABLED="false"
CORS_ORIGINS="http://localhost:5137,http://127.0.0.1:5137"
GENERAL_SKILL_RUNTIME_PYTHON=""
GENERAL_SKILL_RUNTIME_VENV=""
GENERAL_SKILL_RUNTIME_PACKAGES="requests,httpx"
GENERAL_SKILL_RUNTIME_AUTO_INSTALL="true"
# Skill 多源导入默认关闭；开启后上传与固定 GitHub commit 可用。
GENERAL_SKILL_IMPORT_V2_ENABLED="false"
GENERAL_SKILL_OBJECT_STORE_PATH="./data/general-skill-objects"
# 任意 HTTPS ZIP 仅允许管理员明确列出的主机；留空时该来源不出现在能力清单中。
GENERAL_SKILL_HTTPS_ALLOWED_HOSTS=""
# 默认使用系统 DNS；若内网 DNS 对公网域名返回 198.18.0.0/15 Fake-IP，可显式使用 Cloudflare DoH。
GENERAL_SKILL_DNS_RESOLVER="system"
# 可按部署容量收窄；代码层上限分别为 8/4 个活动作业、2 GiB/500 MiB 暂存。
GENERAL_SKILL_IMPORT_TENANT_ACTIVE_LIMIT="4"
GENERAL_SKILL_IMPORT_USER_ACTIVE_LIMIT="2"
GENERAL_SKILL_IMPORT_TENANT_STAGED_BYTES="524288000"
GENERAL_SKILL_IMPORT_USER_STAGED_BYTES="104857600"
GENERAL_SKILL_IMPORT_ASYNC_ENABLED="true"
GENERAL_SKILL_IMPORT_WORKER_POLL_SECONDS="1"
GENERAL_SKILL_IMPORT_WORKER_LEASE_SECONDS="300"
# S2/S3 分阶段切换：先启用 resolver，再启用会话渐进加载；生产默认保持关闭。
GENERAL_SKILL_RESOLVER_V2_SHADOW="false"
GENERAL_SKILL_RESOLVER_V2_ENABLED="false"
GENERAL_SKILL_DYNAMIC_GUIDANCE_ENABLED="false"
GENERAL_SKILL_CATALOG_TOP_K="12"
GENERAL_SKILL_INSTRUCTION_CHAR_LIMIT="48000"
GENERAL_SKILL_TOTAL_INSTRUCTION_CHAR_LIMIT="64000"
GENERAL_SKILL_DEPENDENCY_MAX_DEPTH="4"
GENERAL_SKILL_MAX_LOADED_PER_TURN="12"
GENERAL_SKILL_RESOURCE_READ_BYTES="65536"

# Current desktop/runtime names. Legacy environment variables remain readable
# for one migration cycle, but new deployments should use these names.
GONGGE_XUBAN_HOST="127.0.0.1"
GONGGE_XUBAN_PORT="5137"
GONGGE_XUBAN_PORT_RANGE_START="5137"
GONGGE_XUBAN_PORT_RANGE_END="5199"
GONGGE_XUBAN_HEADLESS="false"
